<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used by scripts/build_signed_ipa.sh when signing with a FREE Apple ID.
  Personal teams cannot use com.apple.developer.family-controls, so it is
  omitted here; the app detects this and falls back to Strict Focus Lock.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_ID)</string>
	</array>
</dict>
</plist>
